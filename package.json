{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng — deterministic 3D game and headless SDLC lab",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "headless": "node src/headless.mjs",
    "test": "node --test",
    "verify": "node scripts/verify.mjs",
    "verify:clean": "node scripts/clean-check.mjs",
    "bench": "node scripts/bench.mjs",
    "soak": "node --expose-gc --max-semi-space-size=1 src/soak.mjs",
    "demo:record": "node scripts/bench.mjs --mode demo --seed 42 --duration 65 --out docs/demo/capture.json --screenshot docs/demo/gameplay.png",
    "verify:release":"node scripts/verify-release.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "ffmpeg-static": "5.3.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
